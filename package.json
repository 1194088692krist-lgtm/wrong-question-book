{
  "name": "wrong-question-book",
  "version": "0.1.0",
  "description": "线上错题本 Web 应用 - Cloudflare Workers + D1 + R2",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create wrong-question-book-db",
    "db:migrate:local": "wrangler d1 migrations apply wrong-question-book-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply wrong-question-book-db --remote",
    "db:seed": "wrangler d1 execute wrong-question-book-db --local --file=./migrations/seed.sql",
    "r2:create": "wrangler r2 bucket create wrong-question-book-assets",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.90.0"
  }
}
